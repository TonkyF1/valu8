# ---------- Frontend (Vite; set in Vercel/Netlify and local .env) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# Optional analytics (leave empty to disable)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ---------- Supabase Edge Function secrets (supabase secrets set ...) ----------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
# AI (OpenAI-compatible chat completions endpoint). LOVABLE_API_KEY is only a fallback for Lovable's gateway.
AI_API_KEY=
AI_GATEWAY_URL=
AI_MODEL=
LOVABLE_API_KEY=
MARKETCHECK_API_KEY=
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_TOKEN_URL=
DVSA_MOT_API_KEY=
VEHICLE_DATA_GLOBAL_API_KEY=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
