# ---------- Frontend (Vite; set in Vercel/Netlify and local .env) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# Optional analytics (leave empty to disable)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Public site URL used for SEO/canonical links (defaults to https://valu8.lovable.app)
VITE_SITE_URL=
# Optional Cloudflare Turnstile bot protection (free). Site key is public.
VITE_TURNSTILE_SITE_KEY=
# Optional Sentry error monitoring (free tier). Leave empty to disable.
VITE_SENTRY_DSN=

# ---------- Supabase Edge Function secrets (supabase secrets set ...) ----------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
# AI (OpenAI-compatible chat completions endpoint). LOVABLE_API_KEY is only a fallback for Lovable's gateway.
AI_API_KEY=
AI_GATEWAY_URL=
AI_MODEL=
LOVABLE_API_KEY=
MARKETCHECK_API_KEY=
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_TOKEN_URL=
DVSA_MOT_API_KEY=
VEHICLE_DATA_GLOBAL_API_KEY=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ---------- Launch readiness (all optional; features stay inactive until set) ----------
# Premium gating is OFF unless this is exactly "true". While off, everyone is treated as premium.
PREMIUM_ENFORCED=
# Cloudflare Turnstile secret. When unset, Turnstile verification is skipped.
TURNSTILE_SECRET_KEY=
# Per-user daily caps override defaults, e.g. DAILY_CAP_ANALYSE=25, DAILY_CAP_ADVERT=40,
# DAILY_CAP_SIMILAR=150, DAILY_CAP_LOOKUP=60, DAILY_CAP_FAIR_PRICE=40, DAILY_CAP_RECALLS=200
DAILY_CAP_ANALYSE=
# Stripe (inactive until STRIPE_SECRET_KEY and STRIPE_PRICE_ID are set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# "subscription" (default) or "payment"
STRIPE_MODE=
# Used for Stripe return URLs; falls back to the request origin.
SITE_URL=
# Override the DVSA recalls CSV source if the default URL moves.
RECALLS_CSV_URL=
